# Copy to .env and change all credentials before exposing services outside a trusted LAN.
M3CLOUD_ENVIRONMENT=development

POSTGRES_DB=m3cloud
POSTGRES_USER=m3cloud
POSTGRES_PASSWORD=change-me-postgres

REDIS_PASSWORD=

S3_ACCESS_KEY=m3cloud
S3_SECRET_KEY=change-me-s3

M3CLOUD_POSTGRES_DSN=postgresql+asyncpg://m3cloud:change-me-postgres@postgres:5432/m3cloud
M3CLOUD_REDIS_URL=redis://redis:6379/0
M3CLOUD_S3_ENDPOINT=http://seaweedfs:8333
M3CLOUD_S3_ACCESS_KEY=m3cloud
M3CLOUD_S3_SECRET_KEY=change-me-s3
M3CLOUD_EMQX_HOST=emqx
M3CLOUD_EMQX_PORT=1883

# DJI Cloud API MQTT client. Leave disabled until Pilot 2 broker settings are configured.
M3CLOUD_DJI_MQTT_ENABLED=false
M3CLOUD_DJI_MQTT_CLIENT_ID=m3-cloud
M3CLOUD_DJI_MQTT_USERNAME=
M3CLOUD_DJI_MQTT_PASSWORD=

M3CLOUD_DJI_TELEMETRY_TTL_SECONDS=15
M3CLOUD_DJI_STATE_CACHE_TTL_SECONDS=86400

# DJI Pilot 2 -> M3-Cloud bootstrap (Cloud Services > Open Platforms).
# Keep disabled until a DJI Cloud API application exists in DJI Developer Center.
M3CLOUD_DJI_PILOT_ENABLED=false
# Secret entered on the Pilot 2 bootstrap page; use a long random value.
M3CLOUD_DJI_PILOT_BOOTSTRAP_TOKEN=
M3CLOUD_DJI_CLOUD_APP_ID=
M3CLOUD_DJI_CLOUD_APP_KEY=
M3CLOUD_DJI_CLOUD_APP_LICENSE=
# Must be reachable by RC Pro Enterprise/Pilot 2. DJI's JSBridge accepts tcp:// or ws://.
M3CLOUD_DJI_PILOT_MQTT_URL=tcp://m3-cloud.local:1883
# Keep Pilot credentials separate from the backend MQTT client so broker ACLs can be added later.
M3CLOUD_DJI_PILOT_MQTT_USERNAME=
M3CLOUD_DJI_PILOT_MQTT_PASSWORD=
# Stable UUID for this M3-Cloud workspace.
M3CLOUD_DJI_WORKSPACE_ID=
M3CLOUD_DJI_PLATFORM_NAME=M3-Cloud
M3CLOUD_DJI_WORKSPACE_NAME=M3-Cloud
M3CLOUD_DJI_WORKSPACE_DESCRIPTION=M3-Cloud DJI Pilot 2 workspace

# Redis Pub/Sub channel used to distribute live events across backend workers.
M3CLOUD_LIVE_REDIS_CHANNEL=m3:live

# MapLibre primary vector style and raster fallback. Empty primary uses MapLibre demo style.
VITE_MAP_STYLE_URL=
VITE_MAP_FALLBACK_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Lyrebird bridge (comma-separated RC/phone IP addresses)
M3CLOUD_LYREBIRD_ENABLED=false
M3CLOUD_LYREBIRD_HOSTS=
M3CLOUD_LYREBIRD_HTTP_PORT=8080
M3CLOUD_LYREBIRD_TELEMETRY_PORT=8081
M3CLOUD_LYREBIRD_TIMEOUT_SECONDS=1.5
M3CLOUD_LYREBIRD_MAVLINK_PORT=14550
M3CLOUD_LYREBIRD_MAVLINK_PEER_PORT=14550
M3CLOUD_LYREBIRD_MAVLINK_TTL_SECONDS=5

# Mission upload stores a sealed plan in Lyrebird only. It never starts execution.
M3CLOUD_MISSION_UPLOAD_ENABLED=false
M3CLOUD_MISSION_UPLOAD_TIMEOUT_SECONDS=6


# External read-only media import folder. Copy DJI SD-card images here on the host.
M3CLOUD_MEDIA_IMPORT_ENABLED=true
M3CLOUD_MEDIA_IMPORT_HOST_PATH=./media-import
M3CLOUD_MEDIA_IMPORT_ROOT=/media-import
# Optional path visible to the external Thermogram Windows workstation,
# e.g. \\m3-cloud\\media-import or Z:\\
M3CLOUD_MEDIA_IMPORT_HANDOFF_ROOT=
M3CLOUD_MEDIA_IMPORT_SCAN_INTERVAL_SECONDS=15
M3CLOUD_MEDIA_IMPORT_MIN_AGE_SECONDS=5
# DJI filenames contain local camera time without an offset. Set this to the
# timezone used by the aircraft/controller when the images were captured.
M3CLOUD_MEDIA_FILENAME_TIMEZONE=Europe/Berlin
M3CLOUD_MEDIA_AUTO_MATCH_FLIGHTS=true
M3CLOUD_MEDIA_AUTO_MATCH_MARGIN_SECONDS=300
# Time candidates are spatially validated when image GPS is available.
M3CLOUD_MEDIA_AUTO_MATCH_MAX_DISTANCE_M=100
M3CLOUD_MEDIA_AUTO_MATCH_MIN_GPS_FRACTION=0.8
M3CLOUD_MEDIA_AUTO_MATCH_MAX_GPS_SAMPLES=64
M3CLOUD_MEDIA_AUTO_MATCH_MAX_SAMPLE_TIME_DELTA_SECONDS=5

# External processing result drop folder. Thermogram exports are copied to
# <host-path>/<processing-job-uuid>/ and imported byte-for-byte into S3-compatible object storage.
M3CLOUD_PROCESSING_IMPORT_HOST_PATH=./processing-import
M3CLOUD_PROCESSING_IMPORT_ROOT=/processing-import
# Optional path visible from the Thermogram workstation, e.g.
# \\m3-cloud\processing-import
M3CLOUD_PROCESSING_IMPORT_HANDOFF_ROOT=

# Optional native M3T radiometric worker. The Compose "thermal" profile expects
# a locally installed/extracted Linux x86-64 DJI Thermal SDK at this host path.
# DJI binaries are intentionally not committed to M3-Cloud.
DJI_TSDK_HOST_PATH=./dji-thermal-sdk
DJI_TSDK_VERSION=1.8_20251211
M3_THERMAL_LOG_LEVEL=INFO
M3_THERMAL_HOTSPOT_DELTA_C=10
M3_THERMAL_HOTSPOT_MIN_PIXELS=4


# Integrated DroneDB Registry for M3M RGB + multispectral datasets.
# Rotate all credentials before use outside a trusted LAN.
DRONEDB_IMAGE=dronedb/registry:latest
DRONEDB_PLATFORM=linux/amd64
DRONEDB_DB_IMAGE=mariadb:10.6
DRONEDB_PORT=5000
DRONEDB_PUBLIC_URL=http://localhost:5000
DRONEDB_SECRET=change-me-dronedb-secret-please-rotate
DRONEDB_ADMIN_EMAIL=admin@example.com
DRONEDB_ADMIN_USERNAME=admin
DRONEDB_ADMIN_PASSWORD=change-me-dronedb
DRONEDB_DB_ROOT_PASSWORD=change-me-dronedb-root
DRONEDB_DB_PASSWORD=change-me-dronedb-db
M3CLOUD_DRONEDB_ENABLED=true
M3CLOUD_DRONEDB_URL=http://dronedb:5000
M3CLOUD_DRONEDB_PUBLIC_URL=http://localhost:5000
M3CLOUD_DRONEDB_ORG=m3cloud
M3CLOUD_DRONEDB_TIMEOUT_SECONDS=300

# Optional WebODM processing target. Images stay on the external media mount and are streamed
# byte-for-byte to WebODM when a processing job is started.
M3CLOUD_WEBODM_ENABLED=false
M3CLOUD_WEBODM_URL=http://webodm-host:8000
M3CLOUD_WEBODM_TOKEN=
M3CLOUD_WEBODM_USERNAME=
M3CLOUD_WEBODM_PASSWORD=
M3CLOUD_WEBODM_TIMEOUT_SECONDS=300
M3CLOUD_PROCESSING_POLL_INTERVAL_SECONDS=5

